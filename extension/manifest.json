{
  "manifest_version": 3,
  "name": "SITHS Web Login (utveckling)",
  "description": "Loggar in när SITHS-kortet sitter i läsaren och loggar ut när det tas ur.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["nativeMessaging", "alarms", "storage"],
  "host_permissions": ["http://localhost:8080/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://localhost:8080/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "SITHS Web Login" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
